# Veritabanı ve Kişisel Kullanıcı Ayarları (Özel — ASLA commit edilmez)
db.sqlite
db.sqlite-journal
presets.json
mcp_config.json

# Gizli dosyalar — asla commit etme
.env
*.env.local
*.secret

# Log ve geçici dosyalar
*.log
*.tmp

# Node modülleri ve build çıktıları (desktop app + vite web)
node_modules/
desktop/dist/
gui/dist/
gui/web/dist/

# OS Özel
Thumbs.db
desktop.ini
.DS_Store

# İnceleme amaçlı örnek projeler — ASLA push edilmez
sample-proje/

# Kullanıcının Yerel İndirdiği Yetenekler, MCP ve Komutlar (Boş Kalıp — Yerel Kalır)
repo/skills/*
!repo/skills/.gitkeep
repo/mcp/*
!repo/mcp/.gitkeep
!repo/mcp/mcp_config.example.json
repo/commands/*
!repo/commands/.gitkeep
repo/server-skills/*
