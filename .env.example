# Ortam değişkenleri — Bu dosyayı .env olarak kopyalayıp doldurun
# cp .env.example .env
# NOT: .env dosyası .gitignore'da, asla commit edilmez!

# ── GitHub MCP ──────────────────────────────────────────────
# github.com > Settings > Developer settings > Personal access tokens
# Gerekli scope'lar: repo, read:org, read:user, workflow
GITHUB_TOKEN=ghp_...

# ── Coolify MCP ─────────────────────────────────────────────
# Coolify dashboard > Settings > API Tokens
COOLIFY_BASE_URL=https://your-coolify-instance.com
COOLIFY_ACCESS_TOKEN=...

# ── Wix MCP ─────────────────────────────────────────────────
# Wix resmi remote MCP kullanır — token gerekmez (https://mcp.wix.com/mcp)
# Ama site-specific işlemler için Wix API key gerekebilir:
# WIX_API_KEY=...
