# Ortam değişkenleri — Bu dosyayı .env olarak kopyalayıp doldurun
# cp .env.example .env
# NOT: .env dosyası .gitignore'da, asla commit edilmez!

# GitHub MCP için
GITHUB_TOKEN=ghp_...

# Brave Search MCP için
BRAVE_API_KEY=BSA...

# Diğer servisler
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
