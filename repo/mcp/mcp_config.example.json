{
  "mcpServers": {
    "dokploy": {
      "command": "npx",
      "args": ["-y", "Dokploy/dokploy@latest"],
      "env": {
        "DOKPLOY_URL": "https://your-server.example.com",
        "DOKPLOY_API_KEY": "${DOKPLOY_API_KEY}"
      }
    },
    "n8n": {
      "command": "npx",
      "args": ["-y", "n8n-io/n8n@latest"],
      "env": {
        "N8N_HOST": "http://localhost:5678",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    }
  }
}
