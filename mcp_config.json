{
  "mcpServers": {
    "wix": {
      "command": "npx",
      "args": [
        "-y",
        "@wix/mcp-server@latest"
      ],
      "env": {
        "WIX_API_KEY": "${WIX_API_KEY}"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/modelcontextprotocol/servers/github:latest"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
